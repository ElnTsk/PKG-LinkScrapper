{
  "version": 1,
  "defaults": {
    "timeout_ms": 8000,
    "concurrency": 10,
    "verify": true,
    "match_threshold": 0.72,
    "max_per_game": 40,
    "max_fetch_per_game": 32,
    "min_host_delay_ms": 150,
    "keep_pages": true,
    "depth": 1,
    "good_ttl_days": 7,
    "trusted_hosts": [
      "1fichier.com", "mediafire.com", "gofile.io", "superpsx.com",
      "dlget.ir", "thesuperboffers.com", "vikingfile.com", "archive.org"
    ]
  },
  "sources": [
    {
      "name": "ddg",
      "type": "search",
      "engine": "duckduckgo",
      "query": "\"{q}\" {console} pkg download",
      "pages": 1,
      "depth": 1,
      "keep_pages": false
    },
    {
      "name": "bing",
      "type": "search",
      "engine": "bing",
      "query": "\"{q}\" {console} pkg (1fichier OR mega OR mediafire OR filecrypt)",
      "pages": 1,
      "depth": 1,
      "keep_pages": false
    },
    {
      "name": "ddg-pastebins",
      "type": "search",
      "engine": "duckduckgo",
      "query": "\"{q}\" ({console} pkg) (site:rentry.co OR site:pastebin.com OR site:controlc.com)",
      "pages": 1,
      "depth": 1,
      "keep_pages": false
    },
    {
      "name": "dlpsgame",
      "type": "index",
      "search_url": "https://dlpsgame.com/?s={q}",
      "paged_url": "https://dlpsgame.com/page/{page}/?s={q}",
      "pages": 3,
      "depth": 1,
      "resolve_redirects": true,
      "keep_pages": true
    },
    {
      "name": "superpsx",
      "type": "index",
      "trusted": true,
      "search_url": "https://www.superpsx.com/?s={q}",
      "paged_url": "https://www.superpsx.com/page/{page}/?s={q}",
      "pages": 2,
      "depth": 1,
      "resolve_redirects": true,
      "keep_pages": true
    },
    {
      "name": "psxhax",
      "type": "index",
      "urls": [
        "https://www.psxhax.com/tags/ps4-pkg-files/"
      ],
      "pages": 1,
      "depth": 1,
      "keep_pages": true
    },
    {
      "name": "pkg-zone",
      "type": "index",
      "urls": [
        "https://pkg-zone.com/?category=pkg",
        "https://pkg-zone.com/?category=fpkg"
      ],
      "pages": 1,
      "depth": 1,
      "keep_pages": true
    },
    {
      "name": "p30day-telegram",
      "type": "index",
      "search_url": "https://t.me/s/p30day_ps5_info2?q={q}",
      "pages": 1,
      "depth": 2,
      "keep_pages": false
    },
    {
      "name": "p30day",
      "type": "index",
      "search_url": "https://www.p30day.ir/?s={q}",
      "paged_url": "https://www.p30day.ir/page/{page}/?s={q}",
      "pages": 3,
      "depth": 1,
      "keep_pages": true
    },
    {
      "name": "archive-org",
      "type": "index",
      "trusted": true,
      "search_url": "https://archive.org/advancedsearch.php?q={q}+pkg&fl[]=identifier&fl[]=title&rows=30&output=json",
      "item_url": "https://archive.org/download/{id}/",
      "pages": 1,
      "depth": 1,
      "keep_pages": false
    },
    {
      "name": "archive-collections",
      "type": "index",
      "trusted": true,
      "urls": [
        "https://archive.org/download/ps4-fpkg-collection-english-c/",
        "https://archive.org/download/ps4-fpkg-collection-english-j/",
        "https://archive.org/download/ps4-fpkg-collection-english-q/",
        "https://archive.org/download/ps4-fpkg-collection-english-v/",
        "https://archive.org/download/ps4-fpkg-collection-english-w/",
        "https://archive.org/download/ps4-fpkg-collection-english-x/",
        "https://archive.org/download/ps4-fpkg-collection-english-z/"
      ],
      "pages": 1,
      "depth": 0,
      "keep_pages": false
    },
    {
      "name": "pegasus-dlps",
      "type": "catalog",
      "trusted": true,
      "console": "PS5",
      "_comment": "official Pegasus DL default source; 1710 PS5 titles, refreshed daily",
      "urls": [
        "https://pegasus-dl.dev/catalogs/dlps.json"
      ],
      "pages": 1,
      "depth": 1,
      "keep_pages": false
    },
    {
      "name": "pegasus-pippo",
      "type": "catalog",
      "trusted": true,
      "console": "PS5",
      "_comment": "exFAT dumps and fpkgs with backports",
      "urls": [
        "https://pegasus-dl.dev/catalogs/pippo.json"
      ],
      "pages": 1,
      "depth": 1,
      "keep_pages": false
    },
    {
      "name": "pegasus-pfs",
      "type": "catalog",
      "trusted": true,
      "console": "PS5",
      "_comment": "ffpfs/pkg builds, part sets labelled in the link names",
      "urls": [
        "https://pegasus-dl.dev/catalogs/pfs.json"
      ],
      "pages": 1,
      "depth": 1,
      "keep_pages": false
    },
    {
      "name": "pegasus-zer0",
      "type": "catalog",
      "trusted": true,
      "console": "PS5",
      "_comment": "zer0game releases; some archives carry a site password noted in the entry",
      "urls": [
        "https://pegasus-dl.dev/catalogs/zer0.json"
      ],
      "pages": 1,
      "depth": 1,
      "keep_pages": false
    },
    {
      "name": "github-ps4db",
      "type": "catalog",
      "trusted": true,
      "console": "PS4",
      "_comment": "dlpsgame-derived database: 6443 PS4 titles with mirror links",
      "urls": [
        "https://raw.githubusercontent.com/huggingfacer04/ps4-games-database/main/ps4_games_with_downloads.json"
      ],
      "pages": 1,
      "depth": 1,
      "keep_pages": false
    },
    {
      "name": "pegasus-ps4",
      "type": "catalog",
      "trusted": true,
      "console": "PS4",
      "_comment": "866 fpkgs on archive.org; most items need an archive.org login and verify as blocked",
      "urls": [
        "https://raw.githubusercontent.com/M3hmetSa1t/pegasus-ps4-collection-catalog/main/pegasus-ps4-catalog.json"
      ],
      "pages": 1,
      "depth": 0,
      "keep_pages": false
    },
    {
      "name": "orbispatches",
      "type": "index",
      "console": "PS4",
      "_comment": "PS4 update tracker: search API -> titleid -> tracker page with patch versions, sizes and firmware",
      "search_url": "https://www.orbispatches.com/api/internal/search?term={q}",
      "item_url": "https://www.orbispatches.com/{id}",
      "pages": 1,
      "depth": 1,
      "keep_pages": true
    },
    {
      "name": "prosperopatches",
      "type": "index",
      "console": "PS5",
      "_comment": "official-update tracker: search API -> titleid -> tracker page with patch versions, sizes and firmware; the patch download url sits behind Turnstile and opens in the browser",
      "search_url": "https://prosperopatches.com/api/internal/search?term={q}",
      "item_url": "https://prosperopatches.com/{id}",
      "pages": 1,
      "depth": 1,
      "keep_pages": true
    },
    {
      "name": "psxhax-forum",
      "type": "index",
      "enabled": false,
      "_comment": "xenforo search answers 403 without a session cookie",
      "search_url": "https://www.psxhax.com/search/?keywords={q}&search_type=thread&title_only=1",
      "pages": 1,
      "depth": 2,
      "keep_pages": false
    },
    {
      "name": "arabicps4games",
      "type": "index",
      "enabled": false,
      "_comment": "titles live in headings, not anchors, and the links are captcha link-lockers",
      "urls": [
        "https://arabicps4games.github.io/"
      ],
      "paged_url": "https://arabicps4games.github.io/indexps4page{page}.html",
      "pages": 10,
      "depth": 1,
      "keep_pages": false
    }
  ]
}
